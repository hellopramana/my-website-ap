---
import BlogLayout from "../../layouts/blogLayout.astro";

import { getCollection } from "astro:content";
import { render } from "astro:content"; //render content from entry

// function to create dynamic route for collection entry(item)
export async function getStaticPaths() {
  const allBlog = await getCollection("blog");

  return allBlog.map((post) => {
    return {
      params: { slug: post.id },
      props: { post },
    };
  });
}
export const prerender = true;
const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout blogTitle={post.data.title + " | Aditya Pramana"}>
  <div class="wrapper blog__wrapper">
    <div class="blog__header">
      <h1>{post.data.title}</h1>
      <img
        src={post.data.image.src}
        alt={post.data.image.alt}
        class="blog__image"
      />

      <span class="blog__date"
        >{post.data.date?.toDateString()} | by {post.data.author}</span
      >
    </div>
    <div class="blog__content">
      <Content />
    </div>
  </div>
</BlogLayout>

<style>
  .blog__wrapper {
    background-color: white;
    border-radius: 1rem;
  }

  .blog__header {
    max-width: 720px;
    margin: auto;
  }

  .blog__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--c-border);
  }

  .blog__date {
    display: inline-block;
    padding-block-start: 1rem;
  }

  .blog__content {
    max-width: 720px;
    margin: auto;
    border-radius: 1rem;
  }
</style>
