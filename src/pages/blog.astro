---
import Layout from "../layouts/default.astro";
import { getCollection } from "astro:content";

const allBlog = await getCollection("blog");
---

<Layout>
  <div class="wrapper">
    <h1>Hello</h1>
    <ul>
      {
        allBlog.map((post) => {
          return (
            <li>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>
