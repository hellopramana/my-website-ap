---
import { slugify } from "../utils/utils";
const frontmatter = Astro.props;
const { url, title, date, image, imageAlt } = frontmatter;
---

<li class="writing__list-item">
  <img
    src={image}
    alt={imageAlt}
    width="245"
    height="auto"
    class="writing__image"
  />
  <div class="writing__content">
    <a href={`/blog/${url}`} class="writing__link">
      {title}
    </a>
    <p class="writing__date">{date}</p>
  </div>
</li>

<style>
  .writing__list-item {
    display: flex;
    list-style: none;
    column-gap: var(--padding-20);
  }

  .writing__link {
    font-family: "Petrona Variable", serif;
    font-weight: 500;
    font-size: var(--text-heading-m);
    text-decoration: none;
    color: var(--text-dark);
    transition: 0.4s;
  }

  .writing__image {
    width: 245px;
    height: auto;
    border-radius: 8px;
  }

  .writing__link:hover {
    color: #a1a1a1;
  }
</style>
