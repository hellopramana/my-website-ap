---
import ProjectCard from "../ProjectCard.astro";

import featuredWorks from "../../collections/featuredworks.json";
---

<!-- featured works -->
<section class="featured-works">
  <section class="latest-projects">
    <div class="wrapper projects__wrapper">
      <h2 class="projects__heading">Latest Projects</h2>
      <div class="projects__list">
        {
          featuredWorks.map((work) => {
            return <ProjectCard img={work.image} url={work.url} />;
          })
        }
      </div>
    </div>
  </section>
</section>

<style is:global>
  .projects__wrapper {
    .projects__heading {
      font-size: var(--text-heading-m);
      font-family: "Petrona Variable";
      font-weight: 500;
      margin-block-end: 40px;
    }

    .projects__list {
      display: flex;
      gap: 20px 20px;
    }
  }
</style>
