---
const { img, url } = Astro.props;
---

<div class="projects__card">
  <a href={url} class="projects__link" target="_blank" rel="noopener">
    <img src={img} alt="" class="projects__thumbnail" />
  </a>
</div>

<style is:global>
  .projects__card {
    overflow: hidden;
    border-radius: 8px;
    border: 8px solid var(--c-border);
    width: 100%;
    height: auto;
  }

  .projects__link {
  }

  .projects__thumbnail {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 4px;
  }
</style>
