---
// import featuredWorks from "../../collections/featuredworks.json";
import { getCollection, getEntry, render } from "astro:content";
const featuredWorks = await getCollection("works", ({ data }) => {
  return data.featured == true;
});
import ProjectCard from "../ProjectCard.astro";
---

<!-- featured works -->
<section class="featured-works">
  <section class="latest-projects">
    <div class="wrapper projects__wrapper">
      <h2 class="projects__heading">Latest Projects</h2>
      <div class="projects__list">
        {
          featuredWorks.map((work) => {
            return (
              <ProjectCard
                image={work.data.cover?.image.src}
                url={work.data.url}
                alt={work.data.alt}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</section>

<style is:global>
  .projects__wrapper {
    .projects__heading {
      font-size: var(--text-heading-m);
      font-family: "Petrona Variable";
      font-weight: 500;
      margin-block-end: 40px;
    }

    .projects__list {
      display: grid;
      gap: 20px 20px;
      grid-template: 1fr / 1fr 1fr 1fr;
    }

    @media (max-width: 900px) {
      .projects__list {
        grid-template: auto / 1fr;
      }
    }
  }
</style>
