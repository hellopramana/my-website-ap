---
import Layout from "../layouts/default.astro";

import FeaturedWork from "../components/sections/FeaturedWorks.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Writings from "../components/sections/Writings.astro";
import { Image } from "astro:assets";
import myPhoto from "/src/assets/aditya-photo.png";
---

<Layout pageTitle="Aditya Pramana" description="Visual Design & Web Developer">
  <section class="hero">
    <div class="wrapper hero__wrapper">
      <Image
        src={myPhoto}
        alt="headshot of Aditya Pramana"
        class="hero__image"
        width="75"
        height="75"
      />
      <h1 class="hero__title">Transform abstract idea into visual & result</h1>
      <p class="hero__text">
        Hey, I'm Aditya! I'm a web designer and developer with a strong visual
        design background. I work with startups and business owners to build
        beautiful websites that actually grow your business. I'm fueled by great
        coffee and love capturing life through photography!
      </p>
    </div>
  </section>

  <FeaturedWork />

  <Testimonials />

  <Writings />
</Layout>

<style>
  /* Hero Home Page */
  .hero__wrapper {
    padding-block-start: var(--padding-120);
    padding-block-end: var(--padding-80);
    display: grid;
    row-gap: 20px;

    .hero__image {
      width: auto;
    }

    .hero__title {
      font-family: "Petrona Variable", serif;
      font-weight: 500;
      font-size: var(--text-heading-l);
    }

    .hero__text {
      font-size: var(--text-body-l);
      line-height: 1.4;
    }
  }
</style>
