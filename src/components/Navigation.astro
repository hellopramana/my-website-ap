---
import menus from "../collections/menus.json";
import { Icon } from "astro-icon/components";
---

<nav class="wrapper nav__wrapper">
  <button class="nav__open" aria-expanded="false" id="btnOpen">
    <Icon name={"general/hamburger-menu"} width="48" height="48" />
  </button>
  <div class="nav__menu">
    <button class="nav__close" id="btnClose">
      <Icon name={"general/close"} width="48" height="48" />
    </button>
    <ul class="nav__links">
      {
        menus.map((menu) => {
          return (
            <li class="nav__item">
              <a href={menu.url} class="nav__link">
                {menu.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  button {
    background-color: inherit;
    border: none;
    padding: 0;
  }

  /* Navigation */
  .nav__wrapper {
    display: flex;
    justify-content: center;
    padding-block: var(--padding-20);
  }

  .nav__open {
  }

  .nav__close {
    background-color: var(--n900);
  }

  .nav__menu {
  }

  .nav__links {
    display: flex;
    gap: 40px;
    list-style: none;
    padding: 0;
  }

  .nav__item {
    list-style: none;
    display: inline;
  }

  .nav__link {
    color: var(--text-dark);
    font-size: var(--text-navlink);
    line-height: 1em;
    text-decoration: none;
    transition: opacity 200ms ease-in-out;
  }

  .nav__link:hover {
    opacity: 0.5;
  }

  @media (max-width: calc(600 / 16 * 1rem)) {
    .nav__wrapper {
    }

    .nav__menu {
      display: flex;
      position: fixed;
      width: 100%;
      /* height: 100vh; */
      padding: 1rem;
      flex-direction: column;
      inset: 0 0 auto 0;
      background-color: var(--n100);
      text-align: center;
      transform: translateX(0) translateY(-100%);
      transition: ease-out 0.3s;
    }

    .nav__open {
      position: fixed;
      inset: auto 1rem auto auto;
      &[aria-expanded="true"] {
        + .nav__menu {
          transform: translateX(0) translateY(0);
        }
      }
    }

    .nav__close {
      margin-inline-start: auto;
      border-radius: 100px;
    }

    .nav__links {
      display: grid;
      justify-content: center;
    }
  }
</style>

<script>
  const btnOpen = document.querySelector("#btnOpen");
  const btnClose = document.querySelector("#btnClose");

  btnOpen.addEventListener("click", menuOpen);
  btnClose.addEventListener("click", menuClose);

  function menuOpen() {
    btnOpen.setAttribute("aria-expanded", "true");
  }

  function menuClose() {
    btnOpen.setAttribute("aria-expanded", "false");
  }
</script>
