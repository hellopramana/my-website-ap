---
import WritingsArchive from "../components/sections/WritingsArchive.astro";
import Layout from "../layouts/default.astro";
import { getCollection } from "astro:content";

const pageTitle = "My Writing";
const allBlog = await getCollection("blog");
---

<Layout>
  <div class="wrapper">
    <div class="writingsArchive__hero">
    <h1 class="writingsArchive__header">
      Tangible idea
    </h1>
    <p class="writingsArchive__text">Writing is one of many way to transform intangable idea to tangible form. It easier to share our abstract idea and train our thinking skill.</p>
    </div>
    <WritingsArchive>
  </div>
</Layout>
<style>
.writingsArchive__hero {
  display: grid;
  align-content: center;
  text-align: center;
  .writingsArchive__header {

  }

  .writingsArchive__text {
    padding-block: 1rem;
max-width: 60ch;
margin: auto;
  }
}
</style>