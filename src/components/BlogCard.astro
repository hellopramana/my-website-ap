---
const frontmatter = Astro.props;
const { url, title, date, image, imageAlt } = frontmatter;
---

<li class="writing__list-item">
  <img src={image} alt={imageAlt} />
  <div class="writing__content">
    <a href={`/blog/${url}`} class="writing__link">
      {title}
    </a>
    <p class="writing__date">{date}</p>
  </div>
</li>

<style>
  .writing__list {
    list-style-type: none;
  }

  .writing__list-item {
    /* padding-block: 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    list-style: none; */
  }

  .writing__link {
    font-family: "Petrona Variable", serif;
    font-weight: 500;
    font-size: var(--text-heading-m);
    text-decoration: none;
    color: var(--text-dark);
    transition: 0.4s;
  }

  .writing__link:hover {
    color: #a1a1a1;
  }
</style>
