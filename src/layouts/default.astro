---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter, fade, slide } from "astro:transitions";

const { pageTitle, description } = Astro.props;
// Supports weights 100-900
import "@fontsource-variable/petrona";
import "@fontsource/carlito";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <ClientRouter />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer></script>
  </head>
  <body>
    <header>
      <Navigation client:load />
    </header>

    <main>
      <slot />
    </main>

    <footer id="footer">
      <Footer />
    </footer>
  </body>
</html>

<style is:global>
  @layer properties {
    :root {
      /* Font Size */

      --fs-32: 2rem;
      --fs-24: 1.5rem;
      --fs-20: 1.25rem;
      --fs-16: 1rem;
      --fs-14: 0.875rem;

      --text-heading-l: var(--fs-32);
      --text-heading-m: var(--fs-24);
      --text-heading-s: var(--fs-16);
      --text-body-l: var(--fs-20);
      --text-body-m: var(--fs-16);
      --text-body-s: var(--fs-14);
      --text-navlink: var(--fs-16);

      /* Padding Value */
      --padding-280: clamp(1.25rem, -4.472rem + 24.41vw, 17.5rem);
      --padding-120: clamp(2.5rem, 1.286rem + 5.18vw, 7.5rem);
      --padding-80: clamp(2.5rem, 1.893rem + 2.59vw, 5rem);
      --padding-40: calc(40 / 16 * 1rem);
      --padding-20: calc(20 / 16 * 1rem);
      --padding-8: calc (8 / 16 * 1rem);

      /* Color */
      --n100: hsl(0, 0%, 100%);
      --n300: hsl(240, 4%, 95%);
      --n400: hsl(0, 0%, 90%);
      --n900: hsl(0, 0%, 28%);

      --main-bg: var(--n300);
      --text-dark: var(--n900);
      --text-light: var(--n100);
      --c-border: var(--n100);
      --c-testimonial-bg: var(--n100);
      --c-border: var(--n400);
    }
  }

  @layer reset-css {
    /* --RESET CSS-- */
    /* 1. Use a more-intuitive box-sizing model */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    /* 2. Remove default margin */
    * {
      margin: 0;
    }

    /* 3. Enable keyword animations */
    @media (prefers-reduced-motion: no-preference) {
      html {
        interpolate-size: allow-keywords;
      }
    }

    html {
      ul {
        padding-inline: 0;
        padding-block: 0;
      }
    }

    body {
      /* 4. Add accessible line-height */
      line-height: 1.5;
      /* 5. Improve text rendering */
      -webkit-font-smoothing: antialiased;
      font-family: "Carlito", sans-serif;
      background-color: var(--main-bg);
      color: var(--text-dark);
    }

    /* 6. Improve media defaults */
    img,
    picture,
    video,
    canvas,
    svg {
      display: block;
      max-width: 100%;
    }

    /* 7. Inherit fonts for form controls */
    input,
    button,
    textarea,
    select {
      font: inherit;
    }

    /* 8. Avoid text overflows */
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      overflow-wrap: break-word;
    }

    /* 9. Improve line wrapping */
    p {
      text-wrap: pretty;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      text-wrap: balance;
      line-height: 1;
      font-family: "Petrona Variable", serif;
      font-weight: 500;
    }

    /*
  10. Create a root stacking context
*/
    #root,
    #__next {
      isolation: isolate;
    }
  }

  @layer utils {
    .visually-hidden {
      position: absolute;
      left: -10000px;
      top: auto;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .wrapper {
      width: clamp(21.875rem, 10.211rem + 49.77vw, 55rem);
      margin-inline: auto;
      padding-block: var(--padding-80);
    }
  }
</style>
