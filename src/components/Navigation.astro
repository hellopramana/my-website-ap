---
import menus from "../collections/menus.json";
import { Icon } from "astro-icon/components";
---

<nav class="wrapper nav__wrapper">
  <div class="nav__menu" id="nav-menu">
    <button class="nav__close" id="closeBtn">
      <Icon name={"general/close"} width="48" height="48" />
    </button>
    <ul class="nav__links">
      {
        menus.map((menu) => {
          return (
            <li class="nav__item">
              <a href={menu.url} class="nav__link">
                {menu.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
  <button class="nav__burger" id="openBtn">
    <Icon name={"general/hamburger-menu"} width="48" height="48" />
  </button>
</nav>

<style>
  button {
    background: inherit;
    border: none;
    padding: 0;
  }
  .nav__wrapper {
    padding-block: var(--padding-20);

    @media (max-width: calc(600 / 16 * 1rem)) {
      position: sticky;
      display: flex;
      justify-content: space-between;
      padding: 1rem;
      width: 100%;
    }
  }

  .nav__menu {
    @media (max-width: calc(600 / 16 * 1rem)) {
      position: absolute;
      display: flex;
      flex-direction: column;
      background: var(--n400);
      width: 100vw;
      inset: 0 0 auto 0;
      text-align: center;
      padding: 1rem;
      justify-content: center;
      translate: 0 -100%;

      &.animating {
        transition: ease-in 0.3s;
      }
    }
  }

  .menuOpen {
    translate: 0 0;
  }

  .nav__close {
    display: none;
  }

  .nav__links {
    list-style: none;
    @media (max-width: calc(600 / 16 * 1rem)) {
      display: flex;
      flex-direction: column;
      font-size: var(--text-navlink);
    }
    display: flex;
    column-gap: 2rem;
    justify-content: center;
  }

  .nav__item {
    padding-block: 1rem;
  }

  .nav__link {
    text-decoration: none;
    color: var(--n900);
  }

  .nav__burger {
    display: none;
  }

  @media (max-width: calc(600 / 16 * 1rem)) {
    .nav__burger {
      margin-inline-start: auto;
      margin-block-end: auto;
      display: inline;
    }

    .nav__close {
      margin-inline-start: auto;
      fill: var(--n400);
      background-color: var(--n900);
      border-radius: 100%;
      display: block;
    }
  }
</style>

<script>
  const navMenu = document.getElementById("nav-menu");
  const openBtn = document.getElementById("openBtn");
  const closeBtn = document.getElementById("closeBtn");

  openBtn.addEventListener("click", openMobileMenu);

  closeBtn.addEventListener("click", closeMobileMenu);

  function openMobileMenu() {
    navMenu?.classList.add("menuOpen", "animating");
  }

  function closeMobileMenu() {
    navMenu?.classList.remove("menuOpen");

    setTimeout(() => {
      navMenu?.classList.remove("animating");
    }, 0.3);
  }
</script>
